# -----------------------------------------------------------------------------
# Marks App / EduAI V5 — Comprehensive Environment Configuration
# Copy this file to .env and adjust credentials for local Docker or Cloud deployment.
# -----------------------------------------------------------------------------

# General & Node Environment
NODE_ENV="development"
PORT=4000
SERVER_URL="http://localhost:3000"
VITE_API_URL="http://localhost:4000/api"
VITE_CMS_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 1. PostgreSQL Relational Database (Institutes, Batches, Users, Attendance)
# -----------------------------------------------------------------------------
POSTGRES_DB="marksapp_core"
POSTGRES_USER="marksapp_admin"
POSTGRES_PASSWORD="postgres_secure_pwd"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://marksapp_admin:postgres_secure_pwd@localhost:5432/marksapp_core?schema=public"

# -----------------------------------------------------------------------------
# 2. MongoDB Document Store (Question Bank, LaTeX Blocks, Exam Attempts)
# -----------------------------------------------------------------------------
MONGO_ROOT_USER="mongo_admin"
MONGO_ROOT_PASSWORD="mongo_secure_pwd"
MONGO_DB="marksapp_questions"
MONGO_PORT=27017
MONGODB_URI="mongodb://mongo_admin:mongo_secure_pwd@localhost:27017/marksapp_questions?authSource=admin"

# -----------------------------------------------------------------------------
# 3. Redis In-Memory Cache & Leaderboards (ZSET, BullMQ Queues)
# -----------------------------------------------------------------------------
REDIS_PASSWORD="redis_secure_pwd"
REDIS_PORT=6379
REDIS_URL="redis://:redis_secure_pwd@localhost:6379"

# -----------------------------------------------------------------------------
# 4. Payload Headless CMS (Editorial Content, Formulas, Announcements)
# -----------------------------------------------------------------------------
PAYLOAD_SECRET="payload_super_secret_jwt_key_32chars_minimum"

# -----------------------------------------------------------------------------
# 5. Appsmith Internal Operations & Support Console
# -----------------------------------------------------------------------------
APPSMITH_PORT=8090
APPSMITH_ADMIN_EMAILS="admin@marksapp.io"

# -----------------------------------------------------------------------------
# 6. Meilisearch Fast Question Search Engine
# -----------------------------------------------------------------------------
MEILI_MASTER_KEY="meili_super_secret_master_key"
MEILI_PORT=7700
MEILISEARCH_HOST="http://localhost:7700"

# -----------------------------------------------------------------------------
# 7. Firebase Client Configuration (Optional Hybrid / Legacy Client Sync)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# -----------------------------------------------------------------------------
# 8. AI Parser & Hint Engine (Claude or Gemini API)
# -----------------------------------------------------------------------------
VITE_GEMINI_API_KEY=""
VITE_ANTHROPIC_API_KEY=""
